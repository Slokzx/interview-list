NODE_ENV=production
PORT=3001

# Supabase — project settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to frontend

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth — https://console.cloud.google.com/ → Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=https://your-backend.railway.app/auth/google/callback

# CORS — comma-separated list of allowed frontend origins
FRONTEND_URL=https://your-app.vercel.app
